# Copy to `.env` if you want to override the Docker Compose defaults.
# `docker compose up -d` uses these values; the API's own settings live in
# server/.env.example.

POSTGRES_USER=shelfcase
POSTGRES_PASSWORD=shelfcase
POSTGRES_DB=shelfcase

# Host port the container publishes. Kept off 5432 so a locally installed
# PostgreSQL is left alone.
POSTGRES_HOST_PORT=55432
