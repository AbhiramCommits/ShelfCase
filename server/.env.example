# Copy to `.env` and adjust. All values below are the development defaults.

NODE_ENV=development
PORT=4000

# Docker Compose publishes postgres:16 on host port 55432.
DATABASE_URL=postgres://shelfcase:shelfcase@localhost:55432/shelfcase

# Database used by `npm test`; created and dropped per run by scripts/test-db.sh.
TEST_DATABASE_URL=postgres://shelfcase:shelfcase@localhost:55432/shelfcase_test

PG_POOL_MAX=10

# debug | info | warn | error | silent
LOG_LEVEL=info

# Where POST /telemetry appends NDJSON.
TELEMETRY_FILE=./var/telemetry.jsonl
